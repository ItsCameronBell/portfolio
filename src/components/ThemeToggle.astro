<button class="theme-toggle" aria-label="Toggle theme" transition:persist><span class="glyph" data-fill="left"></span></button>

<script>
  declare global {
    interface Window {
      __setFavicon?: (theme: string) => void;
    }
  }

  const THEMES = ['light', 'dark', 'paper'] as const;
  const FILLS: Record<(typeof THEMES)[number], string> = {
    light: 'left',
    dark: 'right',
    paper: 'bottom',
  };

  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const glyph = btn?.querySelector<HTMLSpanElement>('.glyph');

  function nextOf(theme: string) {
    return THEMES[(THEMES.indexOf(theme as (typeof THEMES)[number]) + 1) % THEMES.length]!;
  }

  function reflectTheme(theme: string) {
    window.__setFavicon?.(theme);
    if (!btn || !glyph) return;
    glyph.dataset.fill = FILLS[theme as (typeof THEMES)[number]] ?? 'right';
    btn.setAttribute('aria-label', `Switch to ${nextOf(theme)} theme`);
  }

  reflectTheme(document.documentElement.getAttribute('data-theme') ?? 'light');

  btn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') ?? 'light';
    const next = nextOf(current);
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    reflectTheme(next);
  });
</script>

<style>
  .theme-toggle {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    color: var(--muted);
    background: var(--bg);
    border: 1px solid transparent;
    border-radius: 50%;
    padding: 0;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
    line-height: 1;
  }

  .theme-toggle:hover {
    color: var(--accent);
    border-color: var(--border);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 50%;
  }

  /* drawn with CSS rather than a Unicode glyph — half-circle characters like
     ◐ render inconsistently (sometimes near-solid) across browsers/fonts */
  .theme-toggle .glyph {
    position: relative;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.25px currentColor;
    overflow: hidden;
  }

  .theme-toggle .glyph::after {
    content: '';
    position: absolute;
    background: currentColor;
  }

  .theme-toggle .glyph[data-fill='right']::after {
    top: 0;
    right: 0;
    width: 50%;
    height: 100%;
  }

  .theme-toggle .glyph[data-fill='left']::after {
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
  }

  .theme-toggle .glyph[data-fill='bottom']::after {
    bottom: 0;
    left: 0;
    width: 100%;
    height: 50%;
  }
</style>
