<button class="theme-toggle" aria-label="Toggle theme" transition:persist>◐</button>

<script>
  declare global {
    interface Window {
      __setFavicon?: (theme: string) => void;
    }
  }

  const THEMES = ['light', 'dark', 'paper'] as const;
  const ICONS: Record<(typeof THEMES)[number], string> = {
    light: '◐',
    dark: '◑',
    paper: '◒',
  };

  const btn = document.querySelector<HTMLButtonElement>('.theme-toggle');

  function nextOf(theme: string) {
    return THEMES[(THEMES.indexOf(theme as (typeof THEMES)[number]) + 1) % THEMES.length]!;
  }

  function reflectTheme(theme: string) {
    window.__setFavicon?.(theme);
    if (!btn) return;
    btn.textContent = ICONS[theme as (typeof THEMES)[number]] ?? '◐';
    btn.setAttribute('aria-label', `Switch to ${nextOf(theme)} theme`);
  }

  reflectTheme(document.documentElement.getAttribute('data-theme') ?? 'light');

  btn?.addEventListener('click', () => {
    const current = document.documentElement.getAttribute('data-theme') ?? 'light';
    const next = nextOf(current);
    document.documentElement.setAttribute('data-theme', next);
    localStorage.setItem('theme', next);
    reflectTheme(next);
  });
</script>

<style>
  .theme-toggle {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    z-index: 10;
    font-family: var(--mono);
    font-size: 1rem;
    color: var(--muted);
    background: var(--bg);
    border: none;
    padding: 0.25rem;
    cursor: pointer;
    transition: color 0.1s;
    line-height: 1;
  }

  .theme-toggle:hover {
    color: var(--text);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 1px;
  }
</style>
