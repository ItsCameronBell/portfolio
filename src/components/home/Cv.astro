---
import { getSortedExperience, getSortedEducation, getCompensation } from '../../lib/cv';

const experience = await getSortedExperience();
const education = await getSortedEducation();
const compensation = await getCompensation();
---

<section>
  <div class="section-head-row">
    <h2 class="section-head">Experience</h2>
    <a class="section-link" href="/cv.pdf" download="cameron-bell-cv.pdf">[cv.pdf]</a>
  </div>
  {experience.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <div class="cv-list">
      {experience.map((exp) => (
        <div class="cv-item">
          <span class="cv-date">{exp.data.range}</span>
          <div class="cv-body">
            {exp.data.url ? (
              <a class="cv-org" href={exp.data.url} target="_blank" rel="noopener noreferrer">{exp.data.company}</a>
            ) : (
              <span class="cv-org">{exp.data.company}</span>
            )}
            <div class="cv-roles">
              {exp.data.roles.map((role) => (
                <div class="cv-role-entry">
                  {role.range && <span class="cv-role-date">{role.range}</span>}
                  <span class="cv-role">{role.title}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  )}
</section>

<section>
  <h2 class="section-head">Education</h2>
  {education.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <div class="edu-list">
      {education.map((edu) => (
        <div class="edu">
          <span class="edu-date">{edu.data.range}</span>
          <div class="edu-body">
            <div class="edu-degree">{edu.data.degree}</div>
            {edu.data.url ? (
              <a class="edu-org" href={edu.data.url} target="_blank" rel="noopener noreferrer">{edu.data.institution}</a>
            ) : (
              <span class="edu-org">{edu.data.institution}</span>
            )}
          </div>
        </div>
      ))}
    </div>
  )}
</section>

<section>
  <h2 class="section-head">Compensation</h2>
  <div class="comp-scroll">
  <table class="comp-table">
    <thead>
      <tr>
        <th scope="col">Period</th>
        <th scope="col">Company</th>
        <th scope="col">Role</th>
        <th scope="col">Base</th>
      </tr>
    </thead>
    <tbody>
      {compensation.map((row) => (
        <tr>
          <td class="mono">{row.period}</td>
          <td>{row.company}</td>
          <td>{row.role}</td>
          <td class="mono salary">{row.salary}</td>
        </tr>
      ))}
    </tbody>
  </table>
  </div>
  <p class="comp-note">Base salary only. I share this because I think salary transparency is worth something.</p>
</section>

<style>
  .cv-list {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .cv-item {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0 1.25rem;
  }

  .cv-date {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--faint);
    padding-top: 0.2rem;
    line-height: 1.4;
  }

  .cv-org {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--text);
    line-height: 1.35;
    margin-bottom: 0.3rem;
  }

  a.cv-org:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cv-roles {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .cv-role-entry {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .cv-role-date {
    font-family: var(--mono);
    font-size: 0.67rem;
    color: var(--faint);
    flex-shrink: 0;
    min-width: 3.75rem;
  }

  .cv-role {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .edu {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0 1.25rem;
  }

  .edu-date {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--faint);
    padding-top: 0.2rem;
    line-height: 1.4;
  }

  .edu-degree {
    font-size: 0.875rem;
    color: var(--text);
    line-height: 1.35;
    margin-bottom: 0.15rem;
  }

  .edu-org {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.4;
  }

  a.edu-org:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .comp-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .comp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }

  .comp-table th {
    font-family: var(--mono);
    font-size: 0.67rem;
    font-weight: 400;
    color: var(--faint);
    text-align: left;
    padding: 0 1rem 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }

  .comp-table td {
    padding: 0.55rem 1rem 0.55rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    line-height: 1.35;
  }

  .comp-table tbody tr:last-child td {
    border-bottom: none;
  }

  .comp-table .mono {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
  }

  .comp-table .salary {
    color: var(--text);
    white-space: nowrap;
  }

  .comp-note {
    margin-top: 0.85rem;
    font-size: 0.78rem;
    color: var(--faint);
    font-style: italic;
  }

  @media (max-width: 640px) {
    .cv-list { gap: 1.25rem; }

    .cv-item,
    .edu {
      grid-template-columns: 1fr;
      gap: 0.1rem 0;
    }

    .cv-date,
    .edu-date { padding-top: 0; }

    .cv-role-entry { flex-wrap: wrap; gap: 0.35rem; }
  }
</style>
