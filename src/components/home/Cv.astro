---
import { getSortedExperience, getSortedEducation, formatRange } from '../../lib/cv';
import { tenureMonths, formatTenure } from '../../lib/tenure';

const experience = await getSortedExperience();
const education = await getSortedEducation();
---

<!-- id="cv" keeps links from the old two-tab page (/#cv) landing here. -->
{experience.length > 0 && (
  <section id="cv">
    <h2 class="section-head">Experience</h2>
    <div class="entry-list">
      {experience.map((exp) => (
        <div class="entry">
          <div class="entry-meta">
            <span>{formatRange(exp.data.start, exp.data.end)}</span>
            {/* A current role carries its start so the browser can recount it; see the script below. */}
            <span class="cv-tenure" data-start={exp.data.end ? undefined : exp.data.start}>
              {formatTenure(tenureMonths(exp.data.start, exp.data.end))}
            </span>
          </div>
          <div>
            {exp.data.url ? (
              <a class="entry-title" href={exp.data.url} target="_blank" rel="noopener noreferrer">
                {exp.data.company}<span class="entry-arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="entry-title">{exp.data.company}</span>
            )}
            {exp.data.roles.map((role) => (
              <span class="entry-detail">
                {role.title}
                {role.start && <span class="cv-role-date">{formatRange(role.start, role.end)}</span>}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
)}

{education.length > 0 && (
  <section>
    <h2 class="section-head">Education</h2>
    <div class="entry-list">
      {education.map((edu) => (
        <div class="entry">
          <span class="entry-meta">{edu.data.range}</span>
          <div>
            <span class="entry-title">{edu.data.degree}</span>
            {edu.data.url ? (
              <a class="entry-detail" href={edu.data.url} target="_blank" rel="noopener noreferrer">
                {edu.data.institution}<span class="entry-arrow" aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="entry-detail">{edu.data.institution}</span>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>
)}

<style>
  /* Only a company with several dated roles shows them, after each title. */
  .cv-role-date {
    margin-left: 0.75rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--faint);
  }
</style>

<script>
  import { tenureMonths, formatTenure } from '../../lib/tenure';

  /*
   * The site only rebuilds on push, so a current role's build-time length
   * would drift. Recount it against today's month on each visit.
   */
  function refreshTenure() {
    document.querySelectorAll<HTMLElement>('.cv-tenure[data-start]').forEach((el) => {
      el.textContent = formatTenure(tenureMonths(el.dataset.start!));
    });
  }

  document.addEventListener('astro:page-load', refreshTenure);
</script>
