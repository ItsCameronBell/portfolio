---
import { site, links } from '../../config';

// Build-time year: refreshed on every deploy.
const year = new Date().getFullYear();
---

<aside class="sidebar">
  <div class="brand">
    <h1 class="brand-name">{site.name}</h1>
    <p class="brand-role">{site.role}</p>
  </div>

  <p class="sidebar-about">
    I build backend systems and tools for developers.
    Mostly Go, more Postgres than I originally planned for,
    and the occasional Rust detour.
  </p>

  <nav class="sidebar-links" aria-label="Elsewhere">
    {links.map((link) => {
      const external = link.href.startsWith('http');
      return (
        <a
          href={link.href}
          aria-label={link.label}
          title={link.label}
          target={external ? '_blank' : undefined}
          rel={external ? 'noopener noreferrer' : undefined}
        >
          <svg width="16" height="16" fill="currentColor" aria-hidden="true"><use href={`/icons.svg#${link.label}`} /></svg>
        </a>
      );
    })}
  </nav>

  <p class="sidebar-note">Built with Claude. Writing is my own.</p>
  <div class="sidebar-copyright">© {year} {site.name}</div>
</aside>

<style>
  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 3rem 2rem 3rem 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border);
    overflow-y: auto;
  }

  .brand {
    margin-bottom: 1rem;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .brand-name {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .brand-role {
    display: block;
    font-size: 0.82rem;
    font-style: italic;
    color: var(--muted);
    line-height: 1.2;
  }

  .sidebar-about {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .sidebar-links {
    display: flex;
    gap: 1rem;
    line-height: 0;
  }

  /* The padding/margin pair grows the tap target to 24px without moving the icon. */
  .sidebar-links a {
    display: block;
    padding: 0.25rem;
    margin: -0.25rem;
    /* Accent eased a quarter toward the page, full accent on hover. Stays above 3:1 in every theme. */
    color: color-mix(in srgb, var(--accent) 75%, var(--bg));
    transition: color 0.1s;
  }

  .sidebar-links a:hover { color: var(--accent); }

  .sidebar-note,
  .sidebar-copyright {
    font-family: var(--mono);
    font-size: 0.67rem;
    color: var(--faint);
    line-height: 1.55;
  }

  /* Pins the note and copyright to the bottom of the column; the icons stay up with the bio. */
  .sidebar-note {
    margin-top: auto;
    text-wrap: balance;
  }

  .sidebar-copyright { margin-top: 0.4rem; }

  /*
   * Mobile: the sidebar dissolves (display: contents) and its children become
   * flex items of the page's `.site` column. The `order` values below slot
   * around `.main { order: 1 }` in index.astro — keep the two files in sync.
   */
  @media (max-width: 640px) {
    .sidebar { display: contents; }

    .brand { padding-top: 2rem; }

    .sidebar-links {
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
    }

    .sidebar-note {
      order: 2;
      margin-top: auto;
      padding-top: 1.5rem;
    }

    .sidebar-copyright {
      order: 3;
      padding-bottom: 2rem;
    }
  }
</style>
