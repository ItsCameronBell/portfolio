---
import { getSortedProjects, projectHref, projectLinks } from '../../lib/projects';

const projects = await getSortedProjects();
---

<section>
  <h2 class="section-head">Projects</h2>
  {projects.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <div class="project-list" id="project-list">
      {projects.map((p) => {
        const href = projectHref(p);
        // One rule everywhere: the name opens the write-up, outbound links
        // sit in the meta row named after where they actually go.
        const links = projectLinks(p);
        return (
          <div class="project-item">
            <div class="project-head">
              {href ? (
                <a class="project-name project-link" href={href}>
                  {p.data.name}
                  <span class="page-arrow" aria-hidden="true">→</span>
                </a>
              ) : (
                <span class="project-name">{p.data.name}</span>
              )}
            </div>
            <p class="project-desc">{p.data.description}</p>
            <div class="project-stack">
              {p.data.stack.length > 0 && (
                <span class="project-langs">{p.data.stack.map((s) => <span>{s}</span>)}</span>
              )}
              {links.map((link) => (
                <a class="project-ext" href={link.href} target="_blank" rel="noopener noreferrer">
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  )}
  {projects.length > 0 && (
    <button class="project-more" hidden aria-expanded="false" aria-controls="project-list"></button>
  )}
</section>

<script>
  import { initProjectListCollapse } from '../../scripts/project-collapse';

  document.addEventListener('astro:page-load', initProjectListCollapse);
</script>

<style>
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .project-item { display: block; position: relative; }

  .project-item[hidden] { display: none; }

  .project-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.3rem;
  }

  .project-more {
    margin-top: 1.75rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color 0.1s;
  }

  .project-more:hover { color: var(--text); }

  .project-name {
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.1s;
  }

  .project-link:hover { color: var(--accent); }

  /* Marks the projects that open a write-up rather than an external repo. */
  .page-arrow {
    display: inline-block;
    margin-left: 0.3rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--faint);
    transition: color 0.1s, transform 0.1s;
  }

  .project-link:hover .page-arrow {
    color: var(--accent);
    transform: translateX(2px);
  }

  /*
   * Padded past the type's 13px line box so a near-miss can't fall through to
   * the card's stretched link and navigate somewhere else entirely. The
   * negative margin keeps the meta row's spacing unchanged.
   */
  .project-ext {
    position: relative;
    z-index: 1;
    display: inline-block;
    padding: 0.55rem 0;
    margin: -0.55rem 0;
    text-decoration: underline;
    text-decoration-color: var(--border);
    text-underline-offset: 3px;
    transition: color 0.1s, text-decoration-color 0.1s;
  }

  .project-ext:hover {
    color: var(--accent);
    text-decoration-color: var(--accent);
  }

  .project-desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: 0.45rem;
    max-width: 38rem;
  }

  /*
   * Outbound links sit outside the stack's dot-list, or a bare "github" reads
   * as one more technology. A gap separates them; the underline marks them as
   * links without borrowing the sidebar's column context.
   */
  .project-stack {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 1.1rem;
    font-family: var(--mono);
    font-size: 0.67rem;
    color: var(--faint);
  }

  .project-langs span + span::before { content: ' · '; }
</style>
