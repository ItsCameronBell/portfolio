---
import { getSortedProjects, projectHref } from '../../lib/projects';

const projects = await getSortedProjects();
---

<section>
  <h2 class="section-head">Projects</h2>
  {projects.length === 0 ? (
    <p class="empty">Nothing here yet.</p>
  ) : (
    <div class="project-list" id="project-list">
      {projects.map((p) => {
        const href = projectHref(p);
        return (
          <div class="project-item">
            <ul class="project-stack" aria-label="Built with">
              {p.data.stack.map((s) => <li>{s}</li>)}
            </ul>
            <div>
              {href ? (
                <a class="project-name project-link" href={href} target="_blank" rel="noopener noreferrer">
                  {p.data.name}
                </a>
              ) : (
                <span class="project-name">{p.data.name}</span>
              )}
              <p class="project-desc">{p.data.description}</p>
            </div>
          </div>
        );
      })}
    </div>
  )}
  {projects.length > 0 && (
    <button class="project-more" hidden aria-expanded="false" aria-controls="project-list"></button>
  )}
</section>

<script>
  import { initProjectListCollapse } from '../../scripts/project-collapse';

  document.addEventListener('astro:page-load', initProjectListCollapse);
</script>

<style>
  /*
   * Rows mirror the writing list: meta in the shared rail, serif content
   * beside it. Rules mark rows that are links; the CV's rows are not, and
   * stay unruled.
   */
  .project-list { display: flex; flex-direction: column; }

  .project-item {
    position: relative;
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: 0 1.25rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }

  .project-item:first-child { border-top: 1px solid var(--border); }

  .project-item[hidden] { display: none; }

  /* Stretches the name link over the whole row. */
  .project-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-item:hover .project-link { color: var(--accent); }

  .project-stack {
    list-style: none;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--faint);
    padding-top: 0.2rem;
    line-height: 1.4;
  }

  .project-name {
    display: block;
    font-size: 1rem;
    line-height: 1.4;
    margin-bottom: 0.2rem;
    transition: color 0.1s;
  }

  .project-desc {
    font-size: 0.825rem;
    color: var(--muted);
    line-height: 1.5;
    max-width: 38rem;
  }

  .project-more {
    margin-top: 1rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color 0.1s;
  }

  .project-more:hover { color: var(--text); }

  /* Phone: one column, stack drops below the description as a single line. */
  @media (max-width: 640px) {
    .project-item {
      grid-template-columns: 1fr;
      gap: 0.3rem 0;
    }

    .project-stack {
      order: 1;
      display: flex;
      flex-wrap: wrap;
      gap: 0 0.75rem;
      padding-top: 0;
    }
  }
</style>
