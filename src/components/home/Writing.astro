---
import { getSortedPosts, formatMonthYear } from '../../lib/posts';

const posts = await getSortedPosts();
---

{/* Hidden until the first post exists, so the page never opens on an empty section. Tags live on the post page. */}
{posts.length > 0 && (
  <section id="writing">
    <h2 class="section-head">Writing</h2>
    <div class="entry-list">
      {posts.map((post) => (
        <a class="entry" href={`/posts/${post.id}/`}>
          <span class="entry-meta">{formatMonthYear(post.data.date)}</span>
          <div>
            <span class="entry-title">{post.data.title}</span>
            {post.data.description && <span class="entry-detail">{post.data.description}</span>}
          </div>
        </a>
      ))}
    </div>
  </section>
)}

<style>
  /*
   * A rule across the column between the CV and the writing. Its gap below
   * matches the section gap above it.
   */
  #writing::before {
    content: '';
    display: block;
    height: 1px;
    background: var(--border);
    margin-bottom: 2.5rem;
  }
</style>
