---
import { Code } from 'astro:components';
import type { ComponentProps } from 'astro/types';

type CodeProps = ComponentProps<typeof Code>;

interface Props {
  lang: NonNullable<CodeProps['lang']>;
  code: string;
  filename?: string;
}

const { lang, code, filename } = Astro.props;
---

<figure class="cb">
  {filename && <figcaption class="cb-header">{filename}</figcaption>}
  <div class="cb-body">
    <Code
      code={code}
      lang={lang}
      themes={{ light: 'github-light', dark: 'github-dark' }}
      defaultColor={false}
    />
  </div>
</figure>

<style>
  .cb {
    margin: 1.75rem 0;
    border-radius: 4px;
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .cb-header {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--muted);
    background: var(--surface);
    padding: 0.5rem 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  /* Theme colors come from the shared Shiki rules in global.css;
     this only undoes the fence styling the figure frame replaces. */
  .cb-body :global(pre.astro-code) {
    margin: 0 !important;
    border-radius: 0 !important;
    border: none;
    padding: 1.25rem 1.5rem !important;
    font-size: 0.82rem;
    line-height: 1.65;
  }
</style>
