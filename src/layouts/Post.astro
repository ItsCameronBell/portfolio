---
import '../styles/prose.css';
import Layout from './Layout.astro';
import { formatFullDate } from '../lib/posts';
import { site } from '../config';

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
}

const { title, date, description, tags } = Astro.props;
const formattedDate = formatFullDate(date);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  ...(description && { description }),
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  ...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
  url: Astro.url.href,
  mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
  author: {
    '@type': 'Person',
    name: site.name,
    url: Astro.site?.href,
  },
});
---

<Layout title={`${title} — ${site.name}`} description={description} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <main id="main" class="page-wrap">
    <nav class="page-nav">
      <a href="/">← {site.name}</a>
    </nav>
    <header class="post-head">
      <h1 class="post-title">{title}</h1>
      <time class="post-date" datetime={date.toISOString()}>{formattedDate}</time>
      {tags && tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <article class="prose">
      <slot />
    </article>
  </main>
</Layout>

<style>
  .post-head {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .post-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 0.6rem;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .post-date {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
  }

  .post-tags {
    margin-top: 0.6rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--faint);
  }

  .post-tags .tag + .tag { margin-left: 0.35rem; }
  .post-tags .tag::before { content: '#'; }
</style>
