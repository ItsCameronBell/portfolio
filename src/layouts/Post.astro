---
import Layout from './Layout.astro';
import { formatFullDate } from '../lib/posts';

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
}

const { title, date, description, tags } = Astro.props;
const formattedDate = formatFullDate(date);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  ...(description && { description }),
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  ...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
  url: Astro.url.href,
  mainEntityOfPage: { '@type': 'WebPage', '@id': Astro.url.href },
  author: {
    '@type': 'Person',
    name: 'Cameron Bell',
    url: Astro.site?.href,
  },
});
---

<Layout title={`${title} — Cameron Bell`} description={description} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={date.toISOString()} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <main id="main" class="post-wrap">
    <nav class="post-nav">
      <a href="/">← Cameron Bell</a>
    </nav>
    <header class="post-head">
      <h1 class="post-title">{title}</h1>
      <time class="post-date" datetime={date.toISOString()}>{formattedDate}</time>
      {tags && tags.length > 0 && (
        <div class="post-tags">
          {tags.map((tag) => <span class="tag">{tag}</span>)}
        </div>
      )}
    </header>
    <article class="post-body">
      <slot />
    </article>
  </main>
</Layout>

<style is:global>
  .post-wrap {
    max-width: 40rem;
    margin: 0 auto;
    padding: 0 1.5rem 6rem;
  }

  .post-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
    padding: 2.5rem 0 2rem;
  }

  .post-nav a:hover { color: var(--text); }

  .post-head {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2.5rem;
  }

  .post-title {
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.25;
    margin-bottom: 0.6rem;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .post-date {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
  }

  .post-tags {
    margin-top: 0.6rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--faint);
  }

  .post-tags .tag + .tag { margin-left: 0.35rem; }
  .post-tags .tag::before { content: '#'; }

  /* Article prose */
  .post-body {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .post-body p {
    margin-bottom: 1.4rem;
    text-wrap: pretty;
  }

  .post-body h2 {
    font-size: 1.15em;
    font-weight: 600;
    margin: 2.5rem 0 0.75rem;
    letter-spacing: -0.01em;
  }

  .post-body h3 {
    font-size: 1em;
    font-weight: 600;
    margin: 2rem 0 0.6rem;
  }

  .post-body a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-body a:hover { opacity: 0.8; }

  .post-body ul,
  .post-body ol {
    padding-left: 1.5rem;
    margin-bottom: 1.4rem;
  }

  .post-body li {
    margin-bottom: 0.35rem;
  }

  .post-body blockquote {
    border-left: 2px solid var(--border);
    padding-left: 1.25rem;
    margin: 1.5rem 0;
    color: var(--muted);
  }

  .post-body hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .post-body :not(pre) > code {
    font-family: var(--mono);
    font-size: 0.875em;
    background: var(--surface);
    padding: 0.1em 0.35em;
    border-radius: 3px;
  }

  /* Code blocks from markdown fences; theme colors come from the
     shared Shiki rules in global.css */
  .post-body pre.astro-code {
    border-radius: 4px;
    border: 1px solid var(--border);
    overflow-x: auto;
    margin: 1.75rem 0;
    padding: 1.25rem 1.5rem !important;
    font-size: 0.82rem;
    line-height: 1.65;
    font-family: var(--mono);
  }

  .post-body figure.cb {
    margin: 1.75rem 0;
  }
</style>
