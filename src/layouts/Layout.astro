---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'Cameron Bell',
  description = 'Software engineer writing about backend systems, Go, and craft.',
  canonicalUrl = Astro.url.href,
  ogType = 'website',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Cameron Bell" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Cameron Bell" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <ClientRouter />
    <script is:inline>
      (function () {
        // Paper has no OS-preference equivalent, so the favicon dot can only
        // track the active theme via JS, not a prefers-color-scheme media query.
        var DOTS = { light: '#141414', dark: '#f2f2f2', paper: '#f6f1e6' };
        function faviconHref(theme) {
          var fill = DOTS[theme] || DOTS.light;
          var ring = theme === 'paper' ? '<circle cx="16" cy="16" r="13" fill="none" stroke="#b7a679" stroke-width="1.25"/>' : '';
          var svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><circle cx="16" cy="16" r="13" fill="' + fill + '"/>' + ring + '</svg>';
          return 'data:image/svg+xml,' + encodeURIComponent(svg);
        }
        function setFavicon(theme) {
          var link = document.querySelector('link[rel="icon"][type="image/svg+xml"]');
          if (link) link.href = faviconHref(theme);
        }
        window.__setFavicon = setFavicon;

        function apply() {
          const saved = localStorage.getItem('theme');
          const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = saved ?? (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
          setFavicon(theme);
        }
        apply();
        // Reapply before each view-transition swap paints, so the theme
        // never flashes back to the default during navigation.
        if (!window.__themeSwapBound) {
          window.__themeSwapBound = true;
          document.addEventListener('astro:after-swap', apply);
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <ThemeToggle />
    <slot />
  </body>
</html>
