---
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { getSortedPosts, formatMonthYear } from '../lib/posts';
import { getSortedProjects, projectHref, AI_USAGE } from '../lib/projects';
import { getSortedExperience, getSortedEducation, getCompensation } from '../lib/cv';

const posts = await getSortedPosts();
const projects = await Promise.all(
  (await getSortedProjects()).map(async (entry) => ({
    entry,
    AiNote: entry.body?.trim() ? (await render(entry)).Content : null,
  })),
);
const experience = await getSortedExperience();
const education = await getSortedEducation();
const compensation = await getCompensation();

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Cameron Bell',
  jobTitle: 'Software Engineer',
  url: Astro.site?.href,
  sameAs: [
    'https://github.com/cameronbell',
    'https://www.linkedin.com/in/cameronbell',
  ],
});
---

<Layout>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <div class="site">

    <aside class="sidebar">
      <div class="brand">
        <h1 class="brand-name">Cameron Bell</h1>
        <p class="brand-role">Software Engineer</p>
      </div>

      <p class="sidebar-about">
        I build backend systems and tools for developers.
        Mostly Go, more Postgres than I originally planned for,
        and the occasional Rust detour.
      </p>

      <div class="sidebar-spacer"></div>

      <div class="sidebar-links">
        <a href="https://github.com/cameronbell" target="_blank" rel="noopener noreferrer">github</a>
        <a href="https://www.linkedin.com/in/cameronbell" target="_blank" rel="noopener noreferrer">linkedin</a>
        <a href="mailto:me@cameronbell.email">email</a>
        <a href="https://hardcover.app/@cameronbell" target="_blank" rel="noopener noreferrer">hardcover</a>
      </div>

      <p class="sidebar-built">Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a> and <a href="https://claude.ai" target="_blank" rel="noopener noreferrer">Claude</a>. Writing is my own.</p>
      <div class="sidebar-copyright">© 2026 Cameron Bell</div>
    </aside>

    <main id="main" class="main">

      <div class="tab-bar" role="tablist" aria-label="Sections">
        <button class="tab-btn active" id="tab-btn-work" data-tab="work" role="tab" aria-selected="true" aria-controls="tab-work">work</button>
        <button class="tab-btn" id="tab-btn-cv" data-tab="cv" role="tab" aria-selected="false" aria-controls="tab-cv" tabindex="-1">cv</button>
      </div>
      <noscript>
        <style>
          .tab-bar { display: none; }
          .tab-panel { display: block !important; }
          .tab-panel + .tab-panel { margin-top: 3rem; }
        </style>
      </noscript>

      <div class="tab-panel active" id="tab-work" role="tabpanel" aria-labelledby="tab-btn-work" tabindex="0">

        <section>
          <h2 class="section-head">Projects</h2>
          {projects.length === 0 ? (
            <p class="empty">Nothing here yet.</p>
          ) : (
            <div class="project-list" id="project-list">
              {projects.map(({ entry: p, AiNote }) => {
                const href = projectHref(p);
                const ai = p.data.ai && p.data.ai !== 'none' ? AI_USAGE[p.data.ai] : undefined;
                const tipId = AiNote ? `ai-tip-${p.id}` : undefined;
                return (
                  <div class="project-item">
                    <div class="project-head">
                      {href ? (
                        <a class="project-name project-link" href={href} target="_blank" rel="noopener noreferrer">
                          {p.data.name}
                        </a>
                      ) : (
                        <span class="project-name">{p.data.name}</span>
                      )}
                    </div>
                    <p class="project-desc">{p.data.description}</p>
                    <div class="project-stack">
                      <div class="project-langs">
                        {p.data.stack.map((s) => <span>{s}</span>)}
                      </div>
                      {ai && (
                        <div class="ai">
                          <span
                            class="ai-badge"
                            {...(tipId && { tabindex: 0, 'aria-describedby': tipId })}
                          >
                            <span aria-hidden="true">{ai.glyph}</span> {ai.label}
                          </span>
                          {AiNote && (
                            <div class="ai-tip" role="tooltip" id={tipId}>
                              <div class="ai-tip-inner"><AiNote /></div>
                            </div>
                          )}
                        </div>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          )}
          {projects.length > 0 && (
            <button class="project-more" hidden aria-expanded="false" aria-controls="project-list"></button>
          )}
        </section>

        <section>
          <div class="section-head-row">
            <h2 class="section-head">Writing</h2>
            <a class="section-feed" href="/rss.xml">[rss]</a>
          </div>
          {posts.length === 0 ? (
            <p class="empty">Nothing here yet.</p>
          ) : (
            <div class="writing-list">
              {posts.map((post) => (
                <a class="writing-item" href={`/posts/${post.id}/`}>
                  <span class="writing-date">{formatMonthYear(post.data.date)}</span>
                  <div>
                    <div class="writing-title">{post.data.title}</div>
                    {post.data.description && (
                      <div class="writing-desc">{post.data.description}</div>
                    )}
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="writing-tags">
                        {post.data.tags.map((tag: string) => (
                          <span class="tag">{tag}</span>
                        ))}
                      </div>
                    )}
                  </div>
                </a>
              ))}
            </div>
          )}
        </section>

      </div>

      <div class="tab-panel" id="tab-cv" role="tabpanel" aria-labelledby="tab-btn-cv" tabindex="0">

        <section>
          <div class="section-head-row">
            <h2 class="section-head">Experience</h2>
            <a class="cv-download" href="/cv.pdf" download="cameron-bell-cv.pdf">[cv.pdf]</a>
          </div>
          {experience.length === 0 ? (
            <p class="empty">Nothing here yet.</p>
          ) : (
            <div class="cv-list">
              {experience.map((exp) => (
                <div class="cv-item">
                  <span class="cv-date">{exp.data.range}</span>
                  <div class="cv-body">
                    {exp.data.url ? (
                      <a class="cv-org" href={exp.data.url} target="_blank" rel="noopener noreferrer">{exp.data.company}</a>
                    ) : (
                      <span class="cv-org">{exp.data.company}</span>
                    )}
                    <div class="cv-roles">
                      {exp.data.roles.map((role) => (
                        <div class="cv-role-entry">
                          {role.range && <span class="cv-role-date">{role.range}</span>}
                          <span class="cv-role">{role.title}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>

        <section>
          <h2 class="section-head">Education</h2>
          {education.length === 0 ? (
            <p class="empty">Nothing here yet.</p>
          ) : (
            <div class="edu-list">
              {education.map((edu) => (
                <div class="edu">
                  <span class="edu-date">{edu.data.range}</span>
                  <div class="edu-body">
                    <div class="edu-degree">{edu.data.degree}</div>
                    {edu.data.url ? (
                      <a class="edu-org" href={edu.data.url} target="_blank" rel="noopener noreferrer">{edu.data.institution}</a>
                    ) : (
                      <span class="edu-org">{edu.data.institution}</span>
                    )}
                  </div>
                </div>
              ))}
            </div>
          )}
        </section>

        <section>
          <h2 class="section-head">Compensation</h2>
          <div class="comp-scroll">
          <table class="comp-table">
            <thead>
              <tr>
                <th scope="col">Period</th>
                <th scope="col">Company</th>
                <th scope="col">Role</th>
                <th scope="col">Base</th>
              </tr>
            </thead>
            <tbody>
              {compensation.map((row) => (
                <tr>
                  <td class="mono">{row.period}</td>
                  <td>{row.company}</td>
                  <td>{row.role}</td>
                  <td class="mono salary">{row.salary}</td>
                </tr>
              ))}
            </tbody>
          </table>
          </div>
          <p class="comp-note">Base salary only. I share this because I think salary transparency is worth something.</p>
        </section>

      </div>

    </main>
  </div>

  <script>
    import { initTabs } from '../scripts/tabs';
    import { initProjectListCollapse } from '../scripts/project-collapse';

    document.addEventListener('astro:page-load', () => {
      initTabs();
      initProjectListCollapse();
    });
  </script>
</Layout>

<style>
  .site {
    max-width: 60rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 12.5rem 1fr;
    gap: 0 3.5rem;
    min-height: 100vh;
  }

  .sidebar {
    position: sticky;
    top: 0;
    height: 100vh;
    padding: 3rem 2rem 3rem 0;
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border);
    overflow-y: auto;
  }

  .brand {
    margin-bottom: 1rem;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .brand-name {
    display: block;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .brand-role {
    display: block;
    font-size: 0.82rem;
    font-style: italic;
    color: var(--muted);
    line-height: 1.2;
  }

  .sidebar-about {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .sidebar-spacer { flex: 1; }

  .sidebar-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-family: var(--mono);
    font-size: 0.7rem;
    line-height: 1;
    margin-bottom: 1rem;
  }

  .sidebar-links a {
    color: var(--faint);
    transition: color 0.1s;
    width: fit-content;
  }

  .sidebar-links a:hover { color: var(--text); }

  .sidebar-copyright {
    font-family: var(--mono);
    font-size: 0.67rem;
    color: var(--faint);
    margin-top: 0.35rem;
  }

  .sidebar-built {
    font-family: var(--mono);
    font-size: 0.67rem;
    color: var(--faint);
    line-height: 1.5;
    margin-top: 0.75rem;
  }

  .sidebar-built a {
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.1s;
  }

  .sidebar-built a:hover { color: var(--text); }

  .main { padding: 3rem 0 4rem; }

  section + section { margin-top: 3rem; }

  .section-head {
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--muted);
    margin-bottom: 1rem;
  }

  .section-head-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .section-head-row .section-head { margin-bottom: 0; }

  .section-feed {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--faint);
    transition: color 0.1s;
  }

  .section-feed:hover { color: var(--text); }

  .cv-download {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--faint);
    transition: color 0.1s;
  }

  .cv-download:hover {
    color: var(--text);
  }

  .empty {
    font-size: 0.875rem;
    color: var(--faint);
    font-style: italic;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .project-item { display: block; position: relative; }

  .project-item[hidden] { display: none; }

  .project-link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 0.3rem;
  }

  .project-more {
    margin-top: 1.75rem;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color 0.1s;
  }

  .project-more:hover { color: var(--text); }

  .project-name {
    font-size: 0.95rem;
    font-weight: 600;
    transition: color 0.1s;
  }

  .project-link:hover { color: var(--accent); }

  .ai {
    position: relative;
    z-index: 1;
  }

  .ai-badge {
    font-family: var(--mono);
    font-size: 0.67rem;
    color: var(--faint);
    white-space: nowrap;
  }

  .ai-badge[tabindex] {
    cursor: help;
    text-decoration: underline dotted;
    text-underline-offset: 2px;
  }

  .ai-badge:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 1px;
  }

  .ai-tip {
    position: absolute;
    top: 100%;
    right: -0.25rem;
    padding-top: 0.4rem;
    width: max-content;
    max-width: min(20rem, calc(100vw - 3rem));
    z-index: 10;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.1s, visibility 0.1s;
  }

  .ai:hover .ai-tip,
  .ai:focus-within .ai-tip {
    opacity: 1;
    visibility: visible;
  }

  .ai-tip-inner {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 0.5rem 0.7rem;
    font-size: 0.78rem;
    color: var(--muted);
    line-height: 1.55;
  }

  .ai-tip-inner :global(p) { margin: 0; }

  .ai-tip-inner :global(p + p) { margin-top: 0.4em; }

  .ai-tip-inner :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ai-tip-inner :global(a:hover) { color: var(--accent); }

  .project-desc {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.55;
    margin-bottom: 0.45rem;
    max-width: 38rem;
  }

  .project-stack {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--mono);
    font-size: 0.67rem;
    color: var(--faint);
  }

  .project-langs span + span::before { content: ' · '; }

  .writing-list { display: flex; flex-direction: column; }

  .writing-item {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0 1.25rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--border);
  }

  .writing-item:first-child { border-top: 1px solid var(--border); }

  .writing-item:hover .writing-title { color: var(--accent); }

  .writing-date {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--faint);
    padding-top: 0.2rem;
    line-height: 1.4;
  }

  .writing-title {
    font-size: 1rem;
    line-height: 1.4;
    margin-bottom: 0.2rem;
    transition: color 0.1s;
  }

  .writing-desc {
    font-size: 0.825rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .writing-tags {
    margin-top: 0.2rem;
    font-family: var(--mono);
    font-size: 0.67rem;
    color: var(--faint);
  }

  .tag + .tag { margin-left: 0.35rem; }
  .tag::before { content: '#'; }

  .cv-list {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    border-left: 1px solid var(--border);
    padding-left: 1.5rem;
  }

  .cv-item {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 0 1.25rem;
  }

  .cv-date {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--faint);
    padding-top: 0.2rem;
    line-height: 1.4;
  }

  .cv-org {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--text);
    line-height: 1.35;
    margin-bottom: 0.3rem;
  }

  a.cv-org:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .cv-roles {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .cv-role-entry {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .cv-role-date {
    font-family: var(--mono);
    font-size: 0.67rem;
    color: var(--faint);
    flex-shrink: 0;
    min-width: 3.75rem;
  }

  .cv-role {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .edu-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .edu {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0 1.25rem;
  }

  .edu-date {
    font-family: var(--mono);
    font-size: 0.7rem;
    color: var(--faint);
    padding-top: 0.2rem;
    line-height: 1.4;
  }

  .edu-degree {
    font-size: 0.875rem;
    color: var(--text);
    line-height: 1.35;
    margin-bottom: 0.15rem;
  }

  .edu-org {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.4;
  }

  a.edu-org:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .comp-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .comp-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.82rem;
  }

  .comp-table th {
    font-family: var(--mono);
    font-size: 0.67rem;
    font-weight: 400;
    color: var(--faint);
    text-align: left;
    padding: 0 1rem 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }

  .comp-table td {
    padding: 0.55rem 1rem 0.55rem 0;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    line-height: 1.35;
  }

  .comp-table tbody tr:last-child td {
    border-bottom: none;
  }

  .comp-table .mono {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--faint);
  }

  .comp-table .salary {
    color: var(--text);
    white-space: nowrap;
  }

  .comp-note {
    margin-top: 0.85rem;
    font-size: 0.78rem;
    color: var(--faint);
    font-style: italic;
  }

  .tab-bar {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .tab-btn {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--muted);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color 0.1s;
  }

  .tab-btn:not(.active):hover { color: var(--text); }

  .tab-btn.active {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  @media (max-width: 640px) {
    .site {
      display: flex;
      flex-direction: column;
    }

    .sidebar { display: contents; }
    .sidebar-spacer { display: none; }

    .brand { padding-top: 2rem; }

    .sidebar-links {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem 1.1rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
      margin-bottom: 0;
    }

    .main {
      order: 1;
      padding: 1.5rem 0 3rem;
    }

    .sidebar-built {
      order: 2;
      margin-top: auto;
      padding-top: 1.5rem;
    }

    .sidebar-copyright {
      order: 3;
      padding-bottom: 2rem;
    }

    .writing-item {
      grid-template-columns: 1fr;
      gap: 0.1rem 0;
    }

    .writing-date { padding-top: 0; }

    .cv-list { padding-left: 1rem; gap: 1.25rem; }

    .cv-item,
    .edu {
      grid-template-columns: 1fr;
      gap: 0.1rem 0;
    }

    .cv-date,
    .edu-date { padding-top: 0; }

    .cv-role-entry { flex-wrap: wrap; gap: 0.35rem; }
  }
</style>
