---
import '../styles/home.css';
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/home/Sidebar.astro';
import Projects from '../components/home/Projects.astro';
import Writing from '../components/home/Writing.astro';
import Cv from '../components/home/Cv.astro';
import { site, socialGroups } from '../config';

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: Astro.site?.href,
  sameAs: socialGroups.flat().map((link) => link.href).filter((href) => href.startsWith('http')),
});
---

<Layout>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </Fragment>
  <div class="site">

    <Sidebar />

    <main id="main" class="main">

      <div class="tab-bar" role="tablist" aria-label="Sections">
        <button class="tab-btn active" id="tab-btn-work" data-tab="work" role="tab" aria-selected="true" aria-controls="tab-work">work</button>
        <button class="tab-btn" id="tab-btn-cv" data-tab="cv" role="tab" aria-selected="false" aria-controls="tab-cv" tabindex="-1">cv</button>
      </div>
      <noscript>
        <style>
          .tab-bar { display: none; }
          .tab-panel { display: block !important; }
          .tab-panel + .tab-panel { margin-top: 3rem; }
        </style>
      </noscript>

      <div class="tab-panel active" id="tab-work" role="tabpanel" aria-labelledby="tab-btn-work" tabindex="0">
        <Projects />
        <Writing />
      </div>

      <div class="tab-panel" id="tab-cv" role="tabpanel" aria-labelledby="tab-btn-cv" tabindex="0">
        <Cv />
      </div>

    </main>
  </div>

  <script>
    import { initTabs } from '../scripts/tabs';

    document.addEventListener('astro:page-load', initTabs);
  </script>
</Layout>

<style>
  .site {
    max-width: 60rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: grid;
    grid-template-columns: 12.5rem 1fr;
    gap: 0 3.5rem;
    min-height: 100vh;
  }

  .main { padding: 3rem 0 4rem; }

  .tab-bar {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .tab-btn {
    font-family: var(--mono);
    font-size: 0.82rem;
    color: var(--muted);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    transition: color 0.1s;
  }

  .tab-btn:not(.active):hover { color: var(--text); }

  .tab-btn.active {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tab-panel { display: none; }
  .tab-panel.active { display: block; }

  /*
   * Mobile: Sidebar.astro dissolves itself with `display: contents`, so its
   * children join this flex column. `.main { order: 1 }` slots between the
   * sidebar's links (order 0) and its note/copyright (orders 2/3).
   */
  @media (max-width: 640px) {
    .site {
      display: flex;
      flex-direction: column;
    }

    .main {
      order: 1;
      padding: 1.5rem 0 3rem;
    }
  }
</style>
